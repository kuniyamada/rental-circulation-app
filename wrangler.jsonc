{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2025-03-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "721e8a4d-a790-4a5d-aeb0-dfc8dd09fec8"
    }
  ],
  // 予算書ビューア（秘密ではないURLのみ。ID/SECRET は Cloudflare のシークレットに登録）
  "vars": {
    "BUDGET_VIEWER_URL": "https://budget-viewer.yamazaki-8cf.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "webapp-attachments"
    }
  ]
  // 注: Cloudflare Pages では wrangler.jsonc の triggers.crons は無視されます。
  // 自動バックアップ用に別途 backup-worker/ を Cron Worker としてデプロイしています。
  // backup-worker/wrangler.jsonc の triggers.crons をご確認ください。
}
