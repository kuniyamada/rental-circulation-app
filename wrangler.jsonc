{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2025-03-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "721e8a4d-a790-4a5d-aeb0-dfc8dd09fec8"
    }
  ],
  // 予算書表示: Googleドライブ「物件決算書類関係」フォルダのID（秘密ではない）
  // Google への接続は Drive自動保存と同じシークレット（GOOGLE_OAUTH_*）を使う
  "vars": {
    "BUDGET_ROOT_FOLDER_ID": "1nYk_1jl1MeBNfQ1ooSKpbjsLQHKLr0m3"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "webapp-attachments"
    }
  ]
  // 注: Cloudflare Pages では wrangler.jsonc の triggers.crons は無視されます。
  // 自動バックアップ用に別途 backup-worker/ を Cron Worker としてデプロイしています。
  // backup-worker/wrangler.jsonc の triggers.crons をご確認ください。
}
